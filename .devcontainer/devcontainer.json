{
  "name": "EcoRun Logger",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/ecorun-logger-server",
  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": { "label": "EcoRun server", "onAutoForward": "notify" },
    "5173": { "label": "Vite dev server", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "svelte.svelte-vscode"
      ]
    }
  },
  "postCreateCommand": "cd web && pnpm install",
  "remoteUser": "vscode"
}
