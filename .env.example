ECORUN_BIND=0.0.0.0:3000
RUST_LOG=ecorun_logger_server=info
# Unique ID of this node. Entries with this ID are excluded from outbound replication.
ECORUN_SERVER_ID=main
# Set on the main node: URLs must be externally reachable HTTP(S) origins.
# Room IDs and socket keys must match across nodes; replicas should normally use [].
ECORUN_SERVERS=[]
ECORUN_DB_PATH=ecorun.sqlite3
ECORUN_PODIUM_ENDPOINT=telemetry.podium.live:8080
ECORUN_PODIUM_SERIAL=C3PROTO01
