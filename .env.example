ECORUN_BIND=0.0.0.0:3000
RUST_LOG=ecorun_logger_server=info
# List every node on every server. Browser failover and bidirectional cluster
# sync use this same list; do not leave the backup list empty.
ECORUN_NODE_ID=main
# Shared secret (24+ characters) required when multiple nodes are configured.
ECORUN_CLUSTER_TOKEN=
ECORUN_SERVERS=[]
# Directory for per-node telemetry NDJSON. Each Logger node records telemetry locally.
ECORUN_TELEMETRY_DIR=./data
ECORUN_DB_PATH=ecorun.sqlite3
# Optional Discord voice companion process (discord_bridge/bridge.py).
# ECORUN_DISCORD_BOT_TOKEN=your-bot-token
# ECORUN_DISCORD_SERVER_URL=http://127.0.0.1:3000
ECORUN_PODIUM_ENDPOINT=telemetry.podium.live:8080
ECORUN_PODIUM_SERIAL=C3PROTO01
